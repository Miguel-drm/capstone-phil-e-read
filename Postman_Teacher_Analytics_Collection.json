{
  "info": {
    "name": "Phil-E-Read Teacher Analytics API",
    "description": "API endpoints for Teacher Analytics and User Role Breakdown",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get Teacher Analytics",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:5000/api/admin/analytics/teachers",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "admin", "analytics", "teachers"]
        },
        "description": "Get comprehensive teacher analytics data including:\n- Daily activity (Mon-Sun)\n- Weekly engagement (4 weeks)\n- Performance metrics (sessions, assessments, reports)\n- User role breakdown (Teachers, Parents, Students)\n\n**Response includes:**\n- teacherMetrics: Activity, engagement, and performance data\n- userRoleBreakdown: Distribution of users by role\n- Summary statistics"
      },
      "response": []
    },
    {
      "name": "Get Admin Stats",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:5000/api/admin/stats",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "admin", "stats"]
        },
        "description": "Get basic admin statistics including user counts and pending items"
      },
      "response": []
    },
    {
      "name": "Test Admin Routes",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/admin/test",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "admin", "test"]
        },
        "description": "Test endpoint to verify admin routes are working"
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ]
}

